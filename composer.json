{
    "name": "avolle/knx-project-parser",
    "keywords": ["knx", "ets", "project parser"],
    "autoload": {
        "psr-4": {
            "Avolle\\KnxProject\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Avolle\\KnxProject\\": "src",
            "Avolle\\KnxProject\\Test\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-zip": "*",
        "eventsauce/object-hydrator": "^1.6",
        "symfony/serializer": "^7.4",
        "symfony/property-access": "^7.4"
    },
    "require-dev": {
        "symfony/var-dumper": "^v7.2",
        "phpunit/phpunit": "^12.1"
    }
}
